+_TABLE_ROW = re.compile(r"^\s*\|.*\|\s*$")
+_TABLE_DIVIDER = re.compile(r"^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)+\|?\s*$")
+
+
+def _has_table(text: str) -> bool:
+    """True when the reply carries a GFM pipe table (header row + divider row)."""
+    lines = (text or "").splitlines()
+    return any(_TABLE_ROW.match(line) and _TABLE_DIVIDER.match(lines[index + 1])
+               for index, line in enumerate(lines[:-1]))
+
+
+def _final_card_json(text: str) -> str:
+    """JSON 2.0 card: one markdown body (native tables), no streaming, no edit handle."""
+    body = text.replace("<at", "＜at").replace("</at>", "＜/at＞")
+    return json.dumps(
+        {"schema": "2.0", "config": {"update_multi": True},
+         "header": {"title": {"tag": "plain_text", "content": "IMFL 高手"}, "template": "blue"},
+         "body": {"elements": [{"tag": "markdown", "content": body}]}},
+        ensure_ascii=False)
+
