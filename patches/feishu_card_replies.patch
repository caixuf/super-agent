+    # --- 卡片回复（本地增强，card_replies 开启时生效）---
+    _CARD_ID_MAX = 500
+
+    def _remember_card_message(self, message_id: str) -> None:
+        """记住本条消息是卡片，之后的 edit_message 才会走卡片更新（LRU 限长）。"""
+        if not message_id:
+            return
+        self._card_message_ids[message_id] = time.time()
+        self._card_message_ids.move_to_end(message_id)
+        while len(self._card_message_ids) > self._CARD_ID_MAX:
+            self._card_message_ids.popitem(last=False)
+
+    def _is_card_message(self, message_id: str) -> bool:
+        return bool(message_id) and message_id in self._card_message_ids
+
+    def _build_reply_card(self, content: str, *, finalize: bool = False,
+                          started_at: Optional[float] = None) -> dict[str, Any]:
+        """宽卡片：头部=机器人名，主体=markdown，运行中额外挂一行运行时长。
+
+        长任务适配：底部提示按首帧时间戳滚动累加，一眼能看出「还在跑、跑了多久」；
+        完成帧摘掉提示并把头部转为绿色。
+        """
+        name = (str(getattr(self, "_bot_name", "") or "Hermes")).strip() or "Hermes"
+        elements: list[dict[str, Any]] = [{"tag": "markdown", "content": content or " "}]
+        if not finalize:
+            elapsed = max(0, int(time.time() - (started_at or time.time())))
+            mins, secs = divmod(elapsed, 60)
+            tip = f"⏳ 运行中 {mins}分{secs:02d}秒" if mins else f"⏳ 运行中 {secs}秒"
+            elements.append({"tag": "note", "elements": [{"tag": "plain_text", "content": tip}]})
+        return {
+            "config": {"wide_screen_mode": True},
+            "header": {"title": {"tag": "plain_text", "content": name},
+                       "template": "green" if finalize else "blue"},
+            "elements": elements,
+        }
+
+    async def _send_reply_card(self, *, chat_id: str, content: str, reply_to: Optional[str],
+                               metadata: Optional[dict[str, Any]], finalize: bool) -> SendResult:
+        card = self._build_reply_card(content, finalize=finalize)
+        response = await self._feishu_send_with_retry(
+            chat_id=chat_id, msg_type="interactive", payload=json.dumps(card, ensure_ascii=False),
+            reply_to=reply_to, metadata=metadata,
+        )
+        result = self._finalize_send_result(response, "card send failed")
+        if result.success:
+            self._remember_card_message(result.message_id or "")
+        return result
