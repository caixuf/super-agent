{
  "id": "session-archive",
  "schedule": "45 3 * * *",
  "collect": {
    "kind": "command",
    "command": "hermes --profile <p> sessions list --since 1d --limit 20"
  },
  "judge": "只针对上面列出的会话，逐个输出三行：会话标识前 8 位、一句话主题、是否有未完成事项。不打开会话全文、不做全库扫描；超出 20 条的会话不再考虑。",
  "write": {
    "kind": "file",
    "path": "<profile>/state/autotask/session-archive.json"
  },
  "report": {
    "ok": "ok ",
    "fail": "fail "
  },
  "retry": {
    "max": 1,
    "backoff_seconds": 600
  },
  "notify": false
}
