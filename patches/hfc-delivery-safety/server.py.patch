+    async def recover_with_text(
+        self, plan: TerminalDeliveryPlan, session: CardSession,
+    ) -> CardDeliveryResult:
+        """Recover a terminal answer without making card delivery authoritative.
+
+        A card PATCH or replacement-card create can fail while the user's final
+        answer is still available in the normalized session.  The delivery ACK
+        has already been handed to Hermes, so this sidecar must retain its own
+        text fallback instead of relying on Hermes to produce a second answer.
+        The stable UUID lets Feishu deduplicate bounded transport retries.
+        """
+        if session.terminal_delivery_state in {"delivered", "recovered"}:
+            return CardDeliveryResult(
+                message_id=self.app[FEISHU_MESSAGE_IDS_KEY].get(
+                    _session_key_for_session(self.app, session)
+                ),
+                outcome="delivered",
+            )
+        card_result = await self.recover(plan)
+        if card_result.delivered:
+            return card_result
+        target = plan.target
+        text = str(getattr(session, "answer_text", "") or "").strip()
+        if not text:
+            return card_result
+        client = _client_for_bot(self.app, target.bot_id)
+        send_text = getattr(client, "send_text_message", None)
+        if not callable(send_text):
+            return CardDeliveryResult(
+                message_id=None, outcome="not_sent",
+                error_kind="TextFallbackUnavailable",
+            )
+        delivery_uuid = build_delivery_uuid(
+            bot_id=target.bot_id or "default",
+            chat_id=target.chat_id,
+            reply_to_message_id=target.reply_to_message_id or "",
+            session_key=target.recovery_key,
+            delivery_kind="terminal-text-recovery",
+        )
+        try:
+            message_id = await send_text(
+                target.chat_id,
+                text,
+                thread_id=target.thread_id,
+                reply_to_message_id=target.reply_to_message_id,
+                reply_in_thread=target.reply_in_thread,
+                delivery_uuid=delivery_uuid,
+            )
+        except TypeError:
+            try:
+                message_id = await send_text(
+                    target.chat_id,
+                    text,
+                    thread_id=target.thread_id,
+                    reply_to_message_id=target.reply_to_message_id,
+                    reply_in_thread=target.reply_in_thread,
+                )
+            except Exception as exc:
+                return CardDeliveryResult(
+                    message_id=None, outcome="not_sent", error_kind=exc.__class__.__name__,
+                )
+        except Exception as exc:
+            return CardDeliveryResult(
+                message_id=None, outcome="not_sent", error_kind=exc.__class__.__name__,
+            )
+        if not isinstance(message_id, str) or not message_id:
+            return CardDeliveryResult(
+                message_id=None, outcome="not_sent", error_kind="TextFallbackMissingMessageId",
+            )
+        return CardDeliveryResult(message_id=message_id, outcome="delivered")
