+def _terminal_delivery_outcome(result: Any) -> str:
+    if not isinstance(result, dict):
+        return "unknown"
+    delivery = result.get("delivery")
+    if not isinstance(delivery, dict):
+        return "delivered"  # legacy two-key response, compatibility only
+    outcome = delivery.get("outcome")
+    return outcome if outcome in {"delivered", "not_sent", "unknown"} else "unknown"
