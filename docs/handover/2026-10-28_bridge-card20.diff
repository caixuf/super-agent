+def _needs_markdown_component(text: str) -> bool:
+    """Tables, lists, fences and h1-h3 render only in a 2.0 markdown component.
+
+    The 1.0 ``lark_md`` field is inline markup: lists show as literal "- item" and tables
+    as bare pipes. Any rich-text construct therefore forces the 2.0 card.
+    """
+    return bool(_BLOCKY.search(text or ""))
+
+
+def _esc_at(text: str) -> str:
+    return (text or "").replace("<at", "＜at").replace("</at>", "＜/at＞")
+
